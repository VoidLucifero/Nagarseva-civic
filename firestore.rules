rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Issues collection rules
    match /issues/{issueId} {
      // Anyone can read complaints (public feed & map)
      allow read: if true;
      
      // Any authenticated user (including silent anonymous citizens) can create a complaint
      allow create: if request.auth != null;
      
      // Status and department updates restricted to official role
      allow update: if request.auth != null && (
        // Upvotes and confirmations allowed for citizens
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'confirmations'])) ||
        // Department and status changes restricted to official users
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'official')
      );

      // Deletion allowed for authenticated users (for test cleanup and issue removal)
      allow delete: if request.auth != null;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
