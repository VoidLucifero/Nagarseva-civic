rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Issues collection rules
    match /issues/{issueId} {
      // Anyone can read complaints (public feed & map)
      allow read: if true;
      
      // Any authenticated user (including silent anonymous citizens) can create a complaint
      allow create: if request.auth != null;
      
      // Upvotes and confirmations allowed for citizens; status and department updates restricted to official role
      allow update: if request.auth != null && (
        // Upvotes and confirmations allowed for citizens
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'confirmations'])) ||
        // Department and status changes restricted strictly to official role in user document
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'official')
      );

      // Deletion restricted strictly to official role only
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'official';
    }

    // Users collection rules - SECURED AGAINST CLIENT ROLE ELEVATION
    match /users/{userId} {
      // Anyone can read user documents (public profiles, leaderboard)
      allow read: if true;

      // Users can ONLY create/update their OWN user document (request.auth.uid == userId)
      // AND CAN NEVER TOUCH OR SET THE 'role' FIELD VIA CLIENT WRITES!
      allow create: if request.auth != null && request.auth.uid == userId &&
        !('role' in request.resource.data.keys());

      allow update: if request.auth != null && request.auth.uid == userId &&
        !('role' in request.resource.data.diff(resource.data).affectedKeys());

      // Direct client deletion of user documents is blocked
      allow delete: if false;
    }
  }
}
